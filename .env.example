# ==============================================================================
# Enterprise CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure your system environment variables.
# Do NOT commit production credentials or sensitive keys to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# Oracle Database 26ai Cloud Connection
DB_HOST=db.freesql.com
DB_PORT=1521
DB_SERVICE_NAME=26ai_un3c1
DB_USERNAME=YOUR_ORACLE_SCHEMA_USERNAME
DB_PASSWORD=YOUR_ORACLE_SCHEMA_PASSWORD
DB_URL=jdbc:oracle:thin:@//${DB_HOST}:${DB_PORT}/${DB_SERVICE_NAME}

# HikariCP Connection Pool Settings
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=3
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_MAX_LIFETIME=1800000

# Spring Security & Session Configuration
SECURITY_SESSION_TIMEOUT=3600
BCRYPT_STRENGTH=10

# API Documentation & OpenAPI
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/v3/api-docs

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_CRM=DEBUG
LOGGING_LEVEL_ORACLE_JDBC=WARN
